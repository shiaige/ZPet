{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}\\bin\\zpet.exe",
            "args": ["send", "greeting"],
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}\\bin\\zpet.exe",
            "args": ["send", "review"],
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}\\bin\\zpet.exe",
            "args": ["send", "working"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}\\bin\\zpet.exe",
            "args": ["send", "working"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}\\bin\\zpet.exe",
            "args": ["send", "waiting"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}\\bin\\zpet.exe",
            "args": ["send", "failed"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}\\bin\\zpet.exe",
            "args": ["send", "done"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
