#!/usr/bin/env python3
"""zpet hook sender — reads the hook payload from stdin and forwards it to
the daemon via UDP. If the daemon is down, starts it first (so ANY hook
event resurrects the pet). Always exits 0 — a non-zero exit would make
ZCode treat the hook as failed, and exit 2 would BLOCK the tool call."""
import os
import socket
import subprocess
import sys
import time

PORT = 57891
SEP = 0x1F


def main():
    args = sys.argv[1:]
    state = args[1] if len(args) > 1 else ""

    payload = sys.stdin.buffer.read(48 * 1024)

    # daemon holds the port with an exclusive bind, so a successful plain
    # bind here means no daemon is running
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.bind(("127.0.0.1", PORT))
        probe.close()
        spawn_daemon()
        attempts = 4  # daemon boot takes a moment; re-send until its socket is up
    except OSError:
        attempts = 1

    msg = state.encode("ascii", "ignore") + bytes([SEP]) + payload
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    for i in range(attempts):
        sock.sendto(msg, ("127.0.0.1", PORT))
        if i + 1 < attempts:
            time.sleep(0.5)


def spawn_daemon():
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    py = os.path.join(root, ".venv", "bin", "python")
    daemon = os.path.join(root, "daemon", "zpet.py")
    if not (os.path.exists(py) and os.path.exists(daemon)):
        return
    subprocess.Popen([py, daemon], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


if __name__ == "__main__":
    main()
